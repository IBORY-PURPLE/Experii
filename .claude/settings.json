{
  "enabledPlugins": {
    "pstack@cursor-plugins": true
  },
  "attribution": {
    "commit": "🤖\n\nCo-Authored-By: 채우 <lala1522@gachon.ac.kr>\nCo-Authored-By: Claude <noreply@anthropic.com>",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/agents/session-start.mjs"],
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/agents/guard.mjs"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
