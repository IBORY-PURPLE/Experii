# Copy to .env.local for local development. Never commit real values.
SUPABASE_URL=https://swbkvwcznphawuredshr.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only key the database checks on every request (db/0004). Same value as web_private.settings.web_key.
WEB_DB_KEY=
# Comma-separated invite codes (4+ characters each). Visitors enter with /?invite=<code>.
INVITE_CODES=
# mock until the founder connects Claude. Set to anthropic together with ANTHROPIC_API_KEY.
CLAUDE_ADAPTER=mock
ANTHROPIC_API_KEY=
# Optional: model id (default claude-opus-5-5) and effort (low|medium|high|xhigh|max).
CLAUDE_MODEL=
CLAUDE_EFFORT=
# Optional daily limits per visitor (defaults 30 captures, 100 chat messages).
CAPTURE_DAILY_LIMIT=
CHAT_DAILY_LIMIT=
# Optional mock delay in milliseconds (default 1500).
MOCK_DELAY_MS=
